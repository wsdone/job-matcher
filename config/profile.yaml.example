# Job Matcher 用户配置

# 简历路径
resume_path: "/path/to/your/resume.pdf"

# 期望城市
cities:
  - "北京"
  - "上海"

# 期望月薪范围（元）
expected_salary:
  min: 20000
  max: 40000

# 工作年限
work_years: 5

# 住址（用于通勤计算）
home_address: "北京市朝阳区望京SOHO"

# 最大可接受通勤时间（分钟）
max_commute_time: 60

# 通勤方式: driving（驾车）或 transit（公交）
commute_mode: "driving"

# 腾讯地图 API Key（https://lbs.qq.com/dev/console/application/mine）
tencent_map_api_key: ""

# 排除关键词
exclude_keywords:
  - "外包"
  - "猎头"
